# Tokens for the PDF viewer glue fuzzer. Ink2 page object mark names and
# parameter keys cannot be discovered by mutation, and the structural tokens
# are the ones needed to build marked content around them.
"GOOG:INKIsInker"
"GOOG:CrText"
"TextboxId"
"BoundsX"
"BoundsY"
"BoundsWidth"
"BoundsHeight"
"Typeface"
"Alignment"
"Orientation"
"IsBold"
"IsItalic"
"IsStrikethrough"
"Version"
"Text"
"BDC"
"BMC"
"EMC"
"/Tabs /R"
"/StructTreeRoot"
"/MediaBox"

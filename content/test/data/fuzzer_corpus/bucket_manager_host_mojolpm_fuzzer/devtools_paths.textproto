actions {
  bucket_manager_host_remote_action {
    id: 0
    m_get_bucket_for_devtools {
      m_name: "a"
      m_receiver: 1
    }
  }
}
actions {
  bucket_host_remote_action {
    id: 1
    m_get_directory_for_devtools {
      m_directory_path_components {
        values { value: ".." }
        values { value: "nested" }
      }
    }
  }
}
actions { run_until_idle {} }
actions {
  file_system_access_directory_handle_remote_action {
    id: 1
    m_get_entries { m_listener: 0 }
  }
}
sequences { action_indexes: [0, 1, 2, 3] }
sequence_indexes: 0
